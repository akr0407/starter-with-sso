# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/saas_starter"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-in-production-min-32"

# SSO OIDC Configuration
# Get these values from your SSO Admin Dashboard after creating the client
SSO_BASE_URL="https://sso.yourdomain.com"
SSO_CLIENT_ID="<client-id-from-sso>"
SSO_CLIENT_SECRET="<client-secret-from-sso>"

# For development
SSO_REDIRECT_URI="http://localhost:3000/auth/callback"

# For production, change to:
# SSO_REDIRECT_URI="https://yourapp.com/auth/callback"
